# Dependencies
node_modules/

# Build output
dist/

# Environment / secrets — never commit
.env
.env.local
.env.*.local

# Cinderella runtime data (never commit member data or media).
# ANCHORED. An unanchored `media/` also matched `src/media/`, so the metadata
# stripping source was silently skipped by `git add -A` and the deploy started a
# build with four modules missing. Keep the leading slash.
/media/
state/

# Operator-supplied avatar image at the repo root (applied via `npm run avatar`).
# Root-anchored so it does NOT match source files like src/bot/avatar.ts.
/avatar.jpg
/avatar.jpeg
/avatar.png
/avatar.webp

# Generated front-end assets (built by `npm run assets`)
public/

# Logs
*.log
npm-debug.log*

# Editor / OS cruft
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Operator-supplied working files (website template drops etc.)
tmp/

# Parallel-chat AI working directory (PowerShell deploy drivers + HTML previews).
# NEVER COMMIT. These scripts carry the production VPS root SSH target and
# WireGuard tunnel addresses in cleartext; the repo is public. Added at the
# Season 3 close-out (CCB-S3-026) after the pre-push grep found them sitting
# untracked and un-ignored, one `git add -A` away from publication.
local_ai/
# ...and the inventories generated FROM it, which land at the repo root rather
# than inside the ignored directory and were therefore not covered by the line
# above. They list 157 paths out of `local_ai/`. Ignoring the directory but not
# its manifest is the kind of gap that only shows up when someone else runs
# `git add -A` (CCB-S3-044).
local_ai_manifest_*

# Local Claude Code launcher config
.claude/

# Generator bio cache (offline tooling; model output keyed on seed + conditioning + model)
.generator-cache/
